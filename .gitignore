# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# SQLite Database files (persisted locally, never committed)
*.db
*.sqlite
*.sqlite3
vendorflow.db

# Virtual environments
venv/
.venv/
env/
ENV/

# Pytest cache & temporary test files
.pytest_cache/
.coverage
htmlcov/
*.log

# Sensitive environment variables
.env
.env.*

# Streamlit local session/runtime files
.streamlit/secrets.toml

# OS generated files
.DS_Store
Thumbs.db

# User uploaded temporary files
uploads/
tmp/
temp/
